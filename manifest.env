# =============================================================================
# Game manifest
# =============================================================================
# Everything that differs between one Absolute game server image and another.
# Fill this in, write the game's quirks in scripts/quirks, and the shared
# library does the rest. Every value is validated at start by scripts/manifest;
# a missing or malformed required value stops the container rather than being
# guessed.
#
# This file is sourced by bash. Values are plain strings: no command
# substitution, no arrays.
# =============================================================================

# --- Identity ----------------------------------------------------------------
# Lowercase, hyphenated. Becomes the image name, the unix user, /opt/<id>,
# /var/log/<id> and the process supervisor's program name.
GAME_ID=example

# Human-readable, used in logs and the generated documentation.
GAME_NAME="Example Server"

# --- Steam -------------------------------------------------------------------
# The dedicated server's app id (not the game client's).
STEAM_APP_ID=0

# anonymous, or account. `account` means the operator supplies credentials at
# run time; they are never stored in the image and CI needs its own account.
STEAM_LOGIN=anonymous

# The Steam branch to install. `public` unless the Linux server lives elsewhere.
STEAM_BRANCH=public

# linux or windows. `windows` selects the Wine base and passes
# +@sSteamCmdForcePlatformType windows to SteamCMD.
STEAM_PLATFORM=linux

# --- Process -----------------------------------------------------------------
# The server executable, relative to the install directory.
SERVER_BINARY=ExampleServer.sh

# How the running server is recognised in the process table. This is matched
# with a bracket trick so a shell running the match does not kill itself.
SERVER_PROCESS=ExampleServer-Linux-Shipping

# The signal that asks the server to save and exit. INT for most Unreal
# titles, TERM for most Unity ones. Getting this wrong corrupts saves.
STOP_SIGNAL=INT

# How long to wait for a graceful stop before escalating, in seconds.
STOP_TIMEOUT=90

# The log line that means "players can join now". Anchored, not fuzzy: it is
# the difference between a health check that works and one that lies.
READY_LOG_PATTERN='Server startup complete'

# --- Ports -------------------------------------------------------------------
# Forwarded on the operator's router. Comma-separated, each `port/protocol`.
PUBLIC_PORTS=7777/udp

# Never forwarded: admin consoles, web dashboards, telnet. These are documented
# as "keep private" in the install guide and bound to localhost in compose.
PRIVATE_PORTS=

# --- State -------------------------------------------------------------------
# Paths that hold the world, relative to /config. A backup captures these.
SAVE_PATHS=saves

# Paths a disaster snapshot captures, absolute. Usually the install directory
# plus the save paths, so a restore returns a working system and not just data.
SNAPSHOT_PATHS=/opt/example/server

# --- Credentials -------------------------------------------------------------
# The environment variable holding the admin/RCON password, if the game has a
# remote console. Empty means the game has none, and the credential guard is
# skipped. When set, an empty or well-known value is refused and a random one
# is generated into /config/<lowercased name>.
ADMIN_PASSWORD_VAR=

# --- Mods --------------------------------------------------------------------
# thunderstore, ficsit, workshop, oxide, or empty for a game with no supported
# mod ecosystem. Selects which mod source plug-in is active.
MOD_SOURCE=

# What a loaded mod set looks like, for the mod check. Empty when MOD_SOURCE is.
MOD_EXPECT_PLUGINS=0
