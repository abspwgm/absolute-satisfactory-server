# =============================================================================
# Game manifest: Satisfactory
# =============================================================================
# Facts come from the registry entry in abspwgm/absolute-game-servers
# (games.json). Anything this file is not certain of is marked UNVERIFIED and is
# closed by the first green CI run, per CHECKLIST.md.
# =============================================================================

# --- Identity ----------------------------------------------------------------
GAME_ID=satisfactory
GAME_NAME="Satisfactory"

# --- Steam -------------------------------------------------------------------
# 1690800 is the dedicated server app, not the game client (1690800 vs 526870).
STEAM_APP_ID=1690800
STEAM_LOGIN=anonymous
STEAM_BRANCH=public
STEAM_PLATFORM=linux

# --- Process -----------------------------------------------------------------
SERVER_BINARY=FactoryServer.sh

# UNVERIFIED. The launcher script execs an Unreal shipping binary; the exact
# name is what `pgrep` must match, and getting it wrong means the health check
# and the stop path both look at nothing. The first run prints the process
# table, which settles it.
SERVER_PROCESS=FactoryServer-Linux-Shipping

# Unreal dedicated servers save and exit on SIGINT.
STOP_SIGNAL=INT

# Satisfactory autosaves a large world on shutdown; this is the innermost rung
# of the ladder and must stay below supervisor's stopwaitsecs.
STOP_TIMEOUT=120

# UNVERIFIED, and the one most likely to be wrong. It must match a line that
# appears only when players can actually join - not when the process starts.
# Today cost a day in the sibling repositories on exactly this class of
# mistake, so treat a passing suite with a wrong pattern here as luck.
READY_LOG_PATTERN='Server is ready'

# --- Ports -------------------------------------------------------------------
# From the registry: 7777/tcp+udp game traffic, 8888/tcp management API.
PUBLIC_PORTS=7777/udp,7777/tcp
# The management API is not something to expose to the internet.
PRIVATE_PORTS=8888/tcp

# --- State -------------------------------------------------------------------
SAVE_PATHS=saved
SNAPSHOT_PATHS=/opt/satisfactory/server

# --- Credentials -------------------------------------------------------------
# Satisfactory has no admin password in the environment: the first client to
# claim the server sets it through the game. Nothing for the credential guard
# to protect, so it stays off rather than inventing a variable.
ADMIN_PASSWORD_VAR=

# --- Mods --------------------------------------------------------------------
# ficsit.app, wrapped through ficsit-cli. Mods routinely break on game updates,
# which is why this game was picked first: snapshot-and-hold is worth most here.
MOD_SOURCE=ficsit
MOD_EXPECT_PLUGINS=0
